# Build output (tsc).
/dist/
*.tsbuildinfo

# Generated by scripts/prebuild.mjs (derived from package.json)
bin/lib/version.generated.ts

# Node
node_modules/
npm-debug.log*

# Editor / OS
.DS_Store
.vscode/
.idea/
Thumbs.db

# Test artifacts
coverage/
.nyc_output/
# Runtime artifacts
# .paper/ is the active paper workspace created by `pensmith new`.
# ~/.pensmith/ is the global library — outside the repo, listed for awareness only.
.paper/

# Phase 9 tutorial/PII outputs
# The .paper/ line above already ignores these (they live under .paper/), but we
# list them DEFENSIVELY with **/ globs so the guarantee survives if .paper/ is
# ever un-ignored — and so RESEARCH Pitfall 7 (TUTORIAL.md not gitignored) is
# structurally satisfied. TUTORIAL.md is the educator-mode learning artifact;
# INTAKE.raw.local holds UNREDACTED intake answers (PII opt-in) and must NEVER
# be committed.
**/TUTORIAL.md
**/INTAKE.raw.local

# intake writes config.toml at the paper-dir cwd; when a verb/test runs with the
# repo root as cwd it leaks a /config.toml ([project] goal=...) into the source
# tree. It is a paper-workspace artifact, never a repo file (the repo uses
# .planning/config.json). Root-anchored so legit nested config.toml stays trackable.
/config.toml

# Local-only
.env
.env.local
*.log
.claude/
.planning/graphs/
graphify-out/

# Built plugin payload: `npm run bundle` writes the bundles and copies the
# runtime assets into plugin/. It is published only on the release branch;
# source history holds just the hand-written plugin files.
/plugin/dist/
/plugin/templates/
/plugin/references/
/plugin/LICENSE
