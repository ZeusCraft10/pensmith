{
  "name": "pensmith",
  "version": "0.1.0-dev",
  "description": "Structured research-and-drafting assistant for academic papers — verifies every citation against the live source. Two-tier: Claude Code plugin + portable Node CLI.",
  "license": "AGPL-3.0-or-later",
  "author": "Akhil Achanta <akhilachanta8@gmail.com>",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@10.9.0",
  "bin": {
    "pensmith": "dist/bin/pensmith.js"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "prebuild": "node scripts/prebuild.mjs",
    "build": "tsc",
    "dev": "tsx",
    "pensmith": "tsx bin/pensmith.ts",
    "mock-llm": "tsx scripts/mock-llm.mjs",
    "validate:manifests": "node scripts/validate-plugin-manifest.cjs",
    "bundle": "npm run prebuild && node scripts/bundle.mjs",
    "bundle:check": "npm run bundle -- --check",
    "plugin:version": "node scripts/plugin-version.cjs --write",
    "plugin:smoke": "node scripts/plugin-smoke.mjs",
    "test:tier-contract": "node scripts/run-tests.mjs tests/tier-contract/ tests/tier-contract.test.ts",
    "test:cassettes": "node --import tsx --test tests/tier-contract.test.ts",
    "cassettes:refresh": "node scripts/refresh-cassettes.mjs",
    "live:sources": "node scripts/live-sources.mjs",
    "live:verify": "node scripts/live-verify.mjs && node scripts/live-verify-quotes.mjs",
    "check": "npm run prebuild && npm run lint && npm run typecheck && npm run build && npm run test:tier-contract && npm test && npm run validate:manifests && npm run bundle:check",
    "test:coverage": "c8 node scripts/run-tests.mjs"
  },
  "files": [
    "dist/",
    "plugin/",
    "README.md",
    "PRIVACY.md",
    "LICENSE"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.93",
    "@clack/prompts": "^0.7",
    "@modelcontextprotocol/sdk": "^1.29",
    "@pdf-lib/fontkit": "^1.1.1",
    "citation-js": "0.7.22",
    "citty": "^0.2.2",
    "doi-regex": "^0.1.17",
    "jszip": "^3.10.1",
    "openai": "^4",
    "p-retry": "^6",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "1.1.1",
    "proper-lockfile": "^4",
    "smol-toml": "^1.6.1",
    "undici": "^7",
    "yaml": "^2.9.0",
    "zod": "^3.23"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "@types/proper-lockfile": "^4",
    "c8": "^11.0.0",
    "esbuild": "0.27.7",
    "eslint": "^9.0.0",
    "fast-check": "^3",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
