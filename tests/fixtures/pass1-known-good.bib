% tests/fixtures/pass1-known-good.bib: real works, each written the way
% bibliographies really write them, and every one must be OK in Pass 1. Each
% is answered by a recorded registry response in tests/fixtures/cassettes.
% tests/pass1-known-good.test.ts runs them all through runPass1.

% NumPy (Crossref): braced particle surname, ISO 4 journal abbreviation, the
% registrant's uppercase DOI.
@article{numpy-braced,
  title = {The {NumPy} Array: A Structure for Efficient Numerical Computation},
  author = {{van der Walt}, Stéfan and Colbert, S. Chris and Varoquaux, Gaël},
  journal = {Comput. Sci. Eng.},
  year = {2011},
  volume = {13},
  number = {2},
  pages = {22--30},
  doi = {10.1109/MCSE.2011.37}
}

% NumPy: the particle unbraced (citation-js splits it off), initials, no
% diacritics, the subtitle left out, a doi.org DOI, a year one off.
@article{numpy-initials,
  title = {The NumPy array},
  author = {van der Walt, S. and Colbert, S. C. and Varoquaux, G.},
  journal = {Computing in Science and Engineering},
  year = {2010},
  doi = {https://doi.org/10.1109/mcse.2011.37}
}

% NumPy: given-first names, "and others", and the DOI only as a dx.doi.org link.
@article{numpy-given-first,
  title = {The NumPy Array -- a structure for efficient numerical computation},
  author = {Stefan van der Walt and Chris Colbert and others},
  journal = {Computing in Science \& Engineering},
  year = {2011},
  url = {http://dx.doi.org/10.1109/mcse.2011.37}
}

% ATLAS and CMS (Crossref, MathML title): author list cut short.
@article{higgs-mass,
  title = {Combined Measurement of the Higgs Boson Mass in pp Collisions at √s = 7 and 8 TeV with the ATLAS and CMS Experiments},
  author = {Aad, G. and others},
  journal = {Physical Review Letters},
  year = {2015},
  doi = {10.1103/PhysRevLett.114.191803}
}

% Infection and Immunity (Crossref, <i> markup): LaTeX italics in the entry,
% abbreviated journal and initials.
@article{salmonella,
  title = {Comparison of sample sequences of the \textit{Salmonella typhi} genome to the sequence of the complete \textit{Escherichia coli} {K-12} genome},
  author = {McClelland, M. and Wilson, R. K.},
  journal = {Infect. Immun.},
  year = {1998},
  doi = {10.1128/IAI.66.9.4305-4312.1998}
}

% ENCODE (Crossref): a consortium as the only author, without "The".
@article{encode-doi,
  title = {An integrated encyclopedia of {DNA} elements in the human genome},
  author = {{ENCODE Project Consortium}},
  journal = {Nature},
  year = {2012},
  doi = {10.1038/nature11247}
}

% ENCODE (PubMed): cited by its PMID alone, written with its label.
@article{encode-pmid,
  title = {An integrated encyclopedia of DNA elements in the human genome.},
  author = {{The ENCODE Project Consortium}},
  journal = {Nature},
  year = {2012},
  pmid = {PMID: 22955616}
}

