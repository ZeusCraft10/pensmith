  year = {2017},
  eprint = {1706.03762},
  archivePrefix = {arXiv},
  primaryClass = {cs.CL}
}

% Attention (DataCite): the arXiv DOI, a short author list.
@article{attention-doi,
  title = {Attention is all you need},
  author = {Vaswani, A. and Shazeer, N. and others},
  journal = {arXiv preprint arXiv:1706.03762},
  year = {2017},
