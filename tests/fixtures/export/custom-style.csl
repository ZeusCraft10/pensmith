<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="never">
  <!-- A minimal independent CSL 1.0 style that is none of the bundled 8 (D-21-07 tests). -->
  <info>
    <title>Angle-Bracket Test Style</title>
    <id>http://example.org/styles/angle-bracket-test</id>
    <updated>2026-01-01T00:00:00+00:00</updated>
  </info>
  <citation>
    <layout prefix="&lt;&lt;" suffix="&gt;&gt;" delimiter="; ">
      <names variable="author">
        <name form="short"/>
      </names>
      <date variable="issued" prefix=" ">
        <date-part name="year"/>
      </date>
      <group prefix=" at ">
        <text variable="locator"/>
      </group>
    </layout>
  </citation>
  <bibliography>
    <layout suffix=".">
      <names variable="author">
        <name name-as-sort-order="all" sort-separator=", ">
          <name-part name="family" text-case="uppercase"/>
        </name>
      </names>
      <text variable="title" prefix=": "/>
    </layout>
  </bibliography>
</style>
